# Copy this file to .env and fill in your real local values.
# .env must NEVER be committed to git — it's already listed in .gitignore.

# MySQL connection (used for both metadata store and warehouse)
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=olist_lineage_metadata
WAREHOUSE_DB_NAME=olist_warehouse

# Email alerting (fill in when we reach Day 5)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_gmail_address@gmail.com
SMTP_PASSWORD=your_16_char_app_password
ALERT_SENDER_EMAIL=your_gmail_address@gmail.com
ALERT_RECIPIENT_EMAIL=the_recipient_email@example.com
