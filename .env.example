# Copy this file to .env and fill in your real local values.
# .env must NEVER be committed to git — it's already listed in .gitignore.

# MySQL connection (used for both metadata store and warehouse)
DB_HOST=localhost
DB_PORT=3306
DB_USER="root"
DB_PASSWORD="2235"
DB_NAME=olist_lineage_metadata
WAREHOUSE_DB_NAME=olist_warehouse

# Email alerting (fill in when we reach Day 5)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
ALERT_SENDER_EMAIL=your_alert_sender@example.com
ALERT_RECIPIENT_EMAIL=your_email@example.com
